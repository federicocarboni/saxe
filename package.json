{
  "name": "saxe",
  "version": "0.1.0",
  "description": "SAX style push streaming XML parser",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsc && esbuild src/index.ts --outdir=lib/ --bundle --format=esm --target=es2017 --mangle-props=_\\$ --sourcemap",
    "fuzz": "jsfuzz fuzz/target.ts corpus -- --require tsm",
    "install": "npm run build",
    "test": "c8 mocha test/*.test.ts",
    "lint": "dprint fmt && eslint ."
  },
  "keywords": [],
  "author": {
    "name": "Federico Carboni"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@gitlab-org/jsfuzz": "github:federicocarboni/jsfuzz",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/eslint": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "chai-as-promised": "^8.0.2",
    "dprint": "^0.50.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.1.2",
    "mocha": "^11.7.4",
    "tar": "^7.5.1",
    "tsm": "^2.3.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
